COMPOSE_PROJECT_NAME=investview

WEB_HTTP_PORT=8080
API_HTTP_PORT=5122
ALLOWED_HOSTS=*

SQL_SA_PASSWORD=replace-with-a-strong-sql-password
JWT_SIGNING_KEY=replace-with-at-least-32-characters-for-jwt-signing

INVESTVIEW_DEMO_EMAIL=demo@investview.local
INVESTVIEW_DEMO_DISPLAY_NAME=InvestView Demo
INVESTVIEW_DEMO_PASSWORD=replace-with-demo-login-password
INVESTVIEW_DEMO_CURRENCY=VND
INVESTVIEW_DEMO_INITIAL_CASH_BALANCE=100000000

MARKET_STATE_ENVIRONMENT=prod
MARKET_DATA_PROVIDER=Mock
QUOTE_STREAM_SOURCE_PROVIDER=Mock
QUOTE_STREAM_REQUIRE_ACTIVE_SUBSCRIPTIONS=true
SECURITY_DEFINITION_WARMUP_ENABLED=false
DNSE_LOG_RESPONSE_BODIES=false

DNSE_API_KEY=
DNSE_API_SECRET=
